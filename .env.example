# Local development only. Replace secrets and configure HTTPS before production.
POSTGRES_DB=wolsar
POSTGRES_USER=wolsar
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://wolsar:local-development-only@db:5432/wolsar
APP_ENV=development
DEMO_MODE=true
APP_SECRET=local-development-only-replace-with-random-secret
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
LOCAL_AUTH_CODES=true
OTP_DELIVERY=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
STORAGE_PATH=/app/uploads
PUSH_PRIVATE_KEY=
PUSH_PUBLIC_KEY=
PUSH_CONTACT=
